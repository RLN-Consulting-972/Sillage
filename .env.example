# Supabase — récupérables dans Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxx

# ATTENTION — clé sensible (Phase 2, invitation des clients) : ne JAMAIS
# la préfixer par NEXT_PUBLIC_, ne jamais l'exposer au navigateur. Cette
# clé contourne toutes les règles de sécurité de la base de données.
# Disponible dans Supabase > Settings > API Keys, section "Secret keys".
SUPABASE_SERVICE_ROLE_KEY=xxxxx

# Réservé à la Phase 5 (intégration Claude) — ne jamais exposer côté client
ANTHROPIC_API_KEY=
